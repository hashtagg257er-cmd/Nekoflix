<resources>
    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/app_background</item>
        <item name="colorPrimaryDark">@color/black</item>
        <item name="colorAccent">@color/netflix_red</item>

        <!-- General UI colors -->
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:colorBackground">@color/app_background</item>

        <!-- Text colors -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <!-- Mobile App Theme -->
    <style name="AppTheme.Mobile" parent="AppTheme">
        <!-- Specific mobile styles can go here -->
    </style>

    <!-- TV App Theme -->
    <style name="AppTheme.Tv" parent="Theme.Leanback">
        <item name="colorPrimary">@color/app_background</item>
        <item name="colorPrimaryDark">@color/black</item>
        <item name="colorAccent">@color/netflix_red</item>
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:colorBackground">@color/app_background</item>
        <item name="defaultBrandColor">@color/app_background</item>
        <item name="defaultSearchColor">@color/app_background</item>
        
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        
        <!-- Other leanback specific attributes -->
        <item name="preferenceTheme">@style/PreferenceThemeOverlayLeanback</item>
    </style>

    <!-- Splash Screen Theme -->
    <style name="AppTheme.SplashScreen" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_splash_screen</item>
    </style>

</resources>
